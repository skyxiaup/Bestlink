---
interface Props {
  slug: string;
  model: string;
  name: string;
  shortDesc: string;
  image: string;
  categoryLabel: string;
  category: string;
  poeBudget?: string;
  management?: string;
}

const { slug, model, name, shortDesc, image, categoryLabel, category, poeBudget, management } = Astro.props;
---
<article class="product-card">
  <a href={`/products/${category}/${slug}/`} class="card-image">
    <img src={image} alt={model} loading="lazy" />
    <span class="category-badge">{categoryLabel}</span>
  </a>
  <div class="card-body">
    <h3><a href={`/products/${category}/${slug}/`}>{model}</a></h3>
    <p class="product-name">{name}</p>
    <p class="product-desc">{shortDesc}</p>
    <div class="specs">
      {poeBudget && <span class="spec-chip">PoE: {poeBudget}</span>}
      {management && <span class="spec-chip managed">Managed</span>}
    </div>
    <a href={`/products/${slug}/`} class="btn btn-outline">View Details</a>
  </div>
</article>

<style>
  .product-card {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    transition: box-shadow 0.2s, transform 0.2s;
    display: flex;
    flex-direction: column;
  }
  .product-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .card-image { position: relative; display: block; aspect-ratio: 4/3; overflow: hidden; background: #f9fafb; }
  .card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .card-image:hover img { transform: scale(1.05); }
  .category-badge {
    position: absolute; top: 0.75rem; left: 0.75rem;
    background: rgba(0,102,204,0.9); color: #fff;
    font-size: 0.7rem; padding: 0.25rem 0.5rem;
    border-radius: 4px; font-weight: 600;
  }
  .card-body { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; gap: 0.5rem; }
  .card-body h3 { font-size: 1.1rem; }
  .card-body h3 a { color: #1a1a2e; }
  .card-body h3 a:hover { color: #0066cc; }
  .product-name { font-size: 0.8rem; color: #666; }
  .product-desc { font-size: 0.875rem; color: #374151; flex: 1; }
  .specs { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .spec-chip {
    background: #eff6ff; color: #0066cc;
    font-size: 0.7rem; padding: 0.2rem 0.5rem;
    border-radius: 999px; font-weight: 600;
  }
  .spec-chip.managed { background: #f0fdf4; color: #16a34a; }
</style>
