---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';

const featured = products.products.filter(p => p.featured);
---
<Base title="Industrial PoE Switches & Media Converters">
  <Header slot="header" />

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <h1>Industrial Network Equipment</h1>
      <p>PoE switches and media converters engineered for harsh environments. Wide temperature range, rugged construction, reliable performance.</p>
      <div class="hero-actions">
        <a href="/products/" class="btn btn-primary">Browse Products</a>
        <a href="/contact/" class="btn btn-outline">Contact Us</a>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="container">
    <h2 class="section-title">Featured Products</h2>
    <p class="section-subtitle">Industry-leading industrial networking solutions</p>
    <div class="product-grid">
      {featured.map(p => (
        <ProductCard
          slug={p.slug}
          model={p.model}
          name={p.name}
          shortDesc={p.shortDesc}
          image={p.image}
          categoryLabel={p.categoryLabel}
          category={p.category}
          poeBudget={p.poeBudget}
          management={p.management}
        />
      ))}
    </div>
    <div style="text-align:center; margin-top:2rem;">
      <a href="/products/" class="btn btn-outline">View All Products</a>
    </div>
  </section>

  <!-- Categories -->
  <section class="container">
    <h2 class="section-title">Product Categories</h2>
    <p class="section-subtitle">Find the right solution for your industrial application</p>
    <div class="category-grid">
      {products.categories.map(cat => (
        <a href={`/products/${cat.slug}/`} class="category-card">
          <h3>{cat.label}</h3>
          <p>{cat.desc}</p>
          <span class="cat-link">View Products →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Features -->
  <section class="features-section">
    <div class="container">
      <h2 class="section-title">Why Choose BestLink</h2>
      <p class="section-subtitle">Built for industrial environments, backed by expert support</p>
      <div class="features-grid">
        <div class="feature">
          <div class="feature-icon">🌡️</div>
          <h3>Wide Temperature</h3>
          <p>-40°C to 75°C operating range for deployment in extreme conditions.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">⚡</div>
          <h3>PoE Power</h3>
          <p>Up to 240W PoE budget. Power IP cameras, APs, and IoT devices over a single cable.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">🔧</div>
          <h3>Industrial Grade</h3>
          <p>DIN-rail mounting, redundant power input, and IP30 rated enclosures.</p>
        </div>
        <div class="feature">
          <div class="feature-icon">🌐</div>
          <h3>Fiber Uplinks</h3>
          <p>SFP slots for single-mode and multi-mode fiber. Extend networks up to 120km.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .hero {
    background: linear-gradient(135deg, #0066CC 0%, #004499 100%);
    color: #fff;
    padding: 5rem 0;
    text-align: center;
  }
  .hero h1 { font-size: 2.75rem; margin-bottom: 1rem; }
  .hero p { font-size: 1.125rem; max-width: 600px; margin: 0 auto 2rem; opacity: 0.9; }
  .hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .hero .btn-primary { background: #0066cc; color: #fff; border: none; }
  .hero .btn-outline { border-color: rgba(255,255,255,0.4); color: #fff; }
  .hero .btn-outline:hover { background: rgba(255,255,255,0.1); border-color: #fff; }

  .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
  .category-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .category-card {
    padding: 2rem;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    transition: all 0.2s;
    text-decoration: none;
    color: inherit;
    background: #fff;
  }
  .category-card:hover { border-color: #0066cc; box-shadow: 0 4px 12px rgba(0,102,204,0.1); text-decoration: none; transform: translateY(-2px); }
  .category-card h3 { color: #1a1a2e; margin-bottom: 0.75rem; font-size: 1.1rem; }
  .category-card p { font-size: 0.875rem; color: #666; line-height: 1.6; margin-bottom: 1rem; }
  .cat-link { color: #0066cc; font-weight: 600; font-size: 0.875rem; }

  .features-section { background: #f9fafb; padding: 4rem 0; margin-top: 4rem; }
  .features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .feature { text-align: center; }
  .feature-icon { font-size: 2.5rem; margin-bottom: 1rem; }
  .feature h3 { font-size: 1rem; margin-bottom: 0.5rem; color: #1a1a2e; }
  .feature p { font-size: 0.875rem; color: #666; }

  @media (max-width: 1024px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 768px) {
    .hero h1 { font-size: 2rem; }
    .category-grid { grid-template-columns: 1fr; }
    .features-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) { .features-grid { grid-template-columns: 1fr; } }
</style>
